    "test": "node --test",
    "bench": "node scripts/bench.mjs"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "cjk",
    "chinese",
    "line-breaking",
    "knuth-plass",
    "justification",
